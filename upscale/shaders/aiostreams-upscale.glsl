//!DESC upscale
//!HOOK MAIN
//!BIND MAIN
//!BIND UPSCALE_3
//!SAVE MAIN
//!WIDTH UPSCALE_3.w 2 *
//!HEIGHT UPSCALE_3.h 2 *
//!WHEN OUTPUT.h MAIN.h / 1.2 >
vec4 hook() {
    vec2 f = fract(UPSCALE_3_pos * UPSCALE_3_size);
    ivec2 i = ivec2(f * vec2(2.0));
    float e = UPSCALE_3_tex((vec2(0.5) - f) * UPSCALE_3_pt + UPSCALE_3_pos)[i.y * 2 + i.x];
    return MAIN_tex(MAIN_pos) + vec4(vec3((e - 0.5) * 0.317873), 0.0);
}
